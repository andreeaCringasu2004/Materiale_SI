10. barbut — BRUTEFORCE PRNG (srand/rand din libc)
===============================================================================
--- Context ---
Jocul de barbut cere jucatorului un "seed" pentru generatorul de numere
aleatoare, pe care il foloseste intern cu srand(seed) + rand() % 60 pentru
a calcula ruloul jucatorului. Nu exista nicio vulnerabilitate de memorie:
PRNG-ul e cel REAL din libc (glibc), deci putem reproduce exact aceeasi
secventa local, cautand un seed care garanteaza intotdeauna ruloul maxim
posibil (60), si il trimitem de suficiente ori cat sa castigam >=25 din 27
runde necesare.

--- Cod final (barbut.py) ---
from pwn import *
import ctypes

context.log_level = 'info'

HOST = "10.213.0.102"
PORT = 49929

libc = ctypes.CDLL("libc.so.6")


def gaseste_seed_pentru_roll_maxim():
    for seed in range(1, 200000):
        libc.srand(seed)
        r = libc.rand()
        if r % 60 == 59:          # => roll = 59 + 1 = 60, maximul posibil
            return seed
    raise Exception("nu am gasit un seed bun, mareste intervalul de cautare")


SEED_MAGIC = gaseste_seed_pentru_roll_maxim()
log.info(f"Seed gasit care da intotdeauna roll=60: {SEED_MAGIC}")

p = remote(HOST, PORT)

p.recvuntil(b"flag\n")

NUM_RUNDE = 27
castiguri = 0

for runda in range(1, NUM_RUNDE + 1):
    p.recvuntil(b"Choose your lucky number\n")
    p.sendline(str(SEED_MAGIC).encode())

    p.recvuntil(b"Ready?\n")
    p.sendline(b"yes")

    linie = p.recvline(timeout=3).decode(errors="replace")
    log.info(f"[runda {runda:02d}] {linie.strip()!r}")

    rezultat = p.recvline(timeout=3).decode(errors="replace").strip()
    log.info(f"           rezultat: {rezultat!r}")
    if "win" in rezultat:
        castiguri += 1

log.info(f"Castiguri totale: {castiguri} / {NUM_RUNDE} (avem nevoie de >= 25)")

final = p.recvall(timeout=5).decode(errors="replace")
print(final)

